{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/linker",
      "destination": "/linker/index.html"
    },
    {
      "source": "/linker/",
      "destination": "/linker/index.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ]
}
